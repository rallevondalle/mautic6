# Mautic 6 Docker Environment Configuration
# Copy this file to .env and update with your values
# IMPORTANT: Use strong, unique passwords in production!

# Database Configuration
# Use strong passwords - these are just examples!
MYSQL_ROOT_PASSWORD=changeme_root_password
MAUTIC_DB_NAME=mautic
MAUTIC_DB_USER=mautic
MAUTIC_DB_PASSWORD=changeme_db_password

# Mautic Configuration
# Set this to your domain (e.g., https://mautic.yourdomain.com)
# For production with domain: https://mautic6.dubby.online
# For local testing: http://localhost:8080
MAUTIC_URL=http://localhost:8080

# Trusted Proxies
# For development: 0.0.0.0/0
# For production with Nginx reverse proxy: 127.0.0.1,YOUR_SERVER_IP
# Example: MAUTIC_TRUSTED_PROXIES=127.0.0.1,136.144.169.138
MAUTIC_TRUSTED_PROXIES=0.0.0.0/0
